# Required for every course.
GOOGLE_API_KEY=

# Only needed for the langsmith course.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=

# Only needed for the pgvector course (docker compose up -d).
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/ai_learning

# Only needed for the pggraph course (docker compose up -d).
PGGRAPH_DSN=postgresql://postgres:postgres@localhost:5434/graph

# Only needed for the redis course (docker compose up -d).
REDIS_DSN=redis://:redis@localhost:6379

# Not needed for the ollama course: Ollama runs as its own local
# application (not started by docker compose), listening on
# http://localhost:11434 by default. See lessons/ollama/README.md.

# Only needed for the langflow course, lessons 7+: generate with
# `uv run langflow api-key` once your local Langflow server is running,
# see lessons/langflow/01_beginner/07_global_variables_and_secrets/README.md.
LANGFLOW_API_KEY=
